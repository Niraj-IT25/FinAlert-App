

# MongoDB Connection: the address of your database
MONGO_URL=mongodb://localhost:xxxxx/xxxxxx

# Server Port: the number the API listens on (the mobile app expects 5000)
PORT=5000

# Node Environment: "development" while testing, "production" when live
NODE_ENV=development

# JWT Configuration: a long random secret used to sign login tokens
JWT_SECRET=your-super-secret-key-change-this-in-production-2024
